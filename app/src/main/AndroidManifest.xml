<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Restarant_mobile_app">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".auth.pages.LoginActivity"
            android:exported="false"
            android:label="@string/title_activity_login"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.SignupActivity"
            android:exported="false"
            android:label="@string/title_activity_signup"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.ProfileActivity"
            android:exported="false"
            android:label="@string/title_activity_profile"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".products.pages.MenuActivity"
            android:exported="false"
            android:label="@string/title_activity_menu"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".cart.pages.CartActivity"
            android:exported="false"
            android:label="@string/title_activity_cart"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.AdminDashActivity"
            android:exported="false"
            android:label="@string/title_activity_admin_dash"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.AdminProfileActivity"
            android:exported="false"
            android:label="@string/title_activity_admin_profile"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.AdminProductsActivity"
            android:exported="false"
            android:label="@string/title_activity_admin_products"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.AdminUsersActivity"
            android:exported="false"
            android:label="@string/title_activity_admin_users"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.pages.AdminOrdersActivity"
            android:exported="false"
            android:label="@string/title_activity_admin_orders"
            android:theme="@style/Theme.Restarant_mobile_app"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>